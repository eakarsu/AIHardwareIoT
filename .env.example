# Copy to .env and supply local values. Never commit .env.
NODE_ENV=development
JWT_SECRET=
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_hardware_iot
DB_USER=
DB_PASSWORD=
PORT=5001
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ENABLE_DEMO_TELEMETRY=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false

DEVICE_REGISTRY_BASE_URL=
PKI_TRUST_BUNDLE_PATH=
MQTT_BROKER_URL=
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=
TIME_SERIES_BASE_URL=
CMMS_BASE_URL=
EDGE_DEPLOYMENT_BASE_URL=
ALERTING_BASE_URL=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
